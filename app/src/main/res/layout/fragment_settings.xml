<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary"
    android:fitsSystemWindows="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingBottom="100dp">

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Settings"
            android:textSize="26sp"
            android:textColor="@color/obsidian"
            android:fontFamily="sans-serif-medium"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="24dp" />

        <!-- ══ TYPOGRAPHY ══════════════════════════════════════════ -->
        <TextView style="@style/SectionLabel" android:text="TYPOGRAPHY" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/bg_card"
            android:layout_marginBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Font Family -->
                <LinearLayout
                    android:id="@+id/row_font_family"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="16dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?android:attr/selectableItemBackground">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Font Family"
                        android:textSize="14sp"
                        android:textColor="@color/obsidian" />

                    <TextView
                        android:id="@+id/tv_font_family"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="System Default"
                        android:textSize="13sp"
                        android:textColor="@color/obsidian_muted" />

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_chevron_right"
                        android:layout_marginStart="4dp"
                        android:alpha="0.3"
                        android:contentDescription="Choose" />
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="0.5dp"
                    android:background="@color/divider" android:layout_marginHorizontal="16dp"/>

                <!-- Font Size -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="16dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Font Size"
                        android:textSize="14sp"
                        android:textColor="@color/obsidian" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/bg_search_bar"
                        android:paddingHorizontal="4dp">

                        <TextView
                            android:id="@+id/btn_font_decrease"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:text="−"
                            android:textSize="18sp"
                            android:gravity="center"
                            android:textColor="@color/obsidian"
                            android:clickable="true"
                            android:focusable="true"
                            android:background="?android:attr/selectableItemBackgroundBorderless"/>

                        <TextView
                            android:id="@+id/tv_font_size"
                            android:layout_width="36dp"
                            android:layout_height="wrap_content"
                            android:text="15"
                            android:textSize="14sp"
                            android:textColor="@color/obsidian"
                            android:gravity="center"
                            android:fontFamily="sans-serif-medium"/>

                        <TextView
                            android:id="@+id/btn_font_increase"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:text="+"
                            android:textSize="18sp"
                            android:gravity="center"
                            android:textColor="@color/obsidian"
                            android:clickable="true"
                            android:focusable="true"
                            android:background="?android:attr/selectableItemBackgroundBorderless"/>
                    </LinearLayout>
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="0.5dp"
                    android:background="@color/divider" android:layout_marginHorizontal="16dp"/>

                <!-- Line Height -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="16dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Line Spacing"
                        android:textSize="14sp"
                        android:textColor="@color/obsidian" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/bg_search_bar"
                        android:paddingHorizontal="4dp">

                        <TextView
                            android:id="@+id/btn_spacing_dec"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:text="−"
                            android:textSize="18sp"
                            android:gravity="center"
                            android:textColor="@color/obsidian"
                            android:clickable="true"
                            android:focusable="true"
                            android:background="?android:attr/selectableItemBackgroundBorderless"/>

                        <TextView
                            android:id="@+id/tv_line_spacing"
                            android:layout_width="40dp"
                            android:layout_height="wrap_content"
                            android:text="1.5×"
                            android:textSize="13sp"
                            android:textColor="@color/obsidian"
                            android:gravity="center"
                            android:fontFamily="sans-serif-medium"/>

                        <TextView
                            android:id="@+id/btn_spacing_inc"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:text="+"
                            android:textSize="18sp"
                            android:gravity="center"
                            android:textColor="@color/obsidian"
                            android:clickable="true"
                            android:focusable="true"
                            android:background="?android:attr/selectableItemBackgroundBorderless"/>
                    </LinearLayout>
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="0.5dp"
                    android:background="@color/divider" android:layout_marginHorizontal="16dp"/>

                <!-- Font Preview -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Preview"
                        android:textSize="11sp"
                        android:textColor="@color/obsidian_muted"
                        android:layout_marginBottom="6dp"/>

                    <TextView
                        android:id="@+id/tv_font_preview"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="The quick brown fox jumps over the lazy dog."
                        android:textSize="15sp"
                        android:textColor="@color/obsidian"
                        android:lineSpacingMultiplier="1.5"
                        android:padding="10dp"
                        android:background="@drawable/bg_search_bar"/>
                </LinearLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ══ EDITOR ═══════════════════════════════════════════════ -->
        <TextView style="@style/SectionLabel" android:text="EDITOR" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/bg_card"
            android:layout_marginBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Auto-save toggle -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="16dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Auto Save"
                            android:textSize="14sp"
                            android:textColor="@color/obsidian"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Save after 2 seconds of inactivity"
                            android:textSize="11sp"
                            android:textColor="@color/obsidian_muted"/>
                    </LinearLayout>

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switch_autosave"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        app:thumbTint="@color/obsidian"
                        app:trackTint="@color/accent_light"/>
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="0.5dp"
                    android:background="@color/divider" android:layout_marginHorizontal="16dp"/>

                <!-- Markdown highlight toggle -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="16dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Syntax Highlight"
                            android:textSize="14sp"
                            android:textColor="@color/obsidian"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Live markdown color in editor"
                            android:textSize="11sp"
                            android:textColor="@color/obsidian_muted"/>
                    </LinearLayout>

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switch_syntax"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        app:thumbTint="@color/obsidian"
                        app:trackTint="@color/accent_light"/>
                </LinearLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ══ TELEGRAM ══════════════════════════════════════════════ -->
        <TextView style="@style/SectionLabel" android:text="TELEGRAM" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/bg_card"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bot Token"
                    android:textSize="12sp"
                    android:textColor="@color/obsidian_muted"
                    android:layout_marginBottom="6dp"/>

                <EditText
                    android:id="@+id/et_bot_token"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_search_bar"
                    android:hint="123456789:ABCdef…"
                    android:textSize="13sp"
                    android:textColor="@color/obsidian"
                    android:textColorHint="@color/obsidian_muted"
                    android:paddingHorizontal="12dp"
                    android:inputType="textNoSuggestions"
                    android:layout_marginBottom="12dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Channel ID"
                    android:textSize="12sp"
                    android:textColor="@color/obsidian_muted"
                    android:layout_marginBottom="6dp"/>

                <EditText
                    android:id="@+id/et_channel_id"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_search_bar"
                    android:hint="-100xxxxxxxxxx"
                    android:textSize="13sp"
                    android:textColor="@color/obsidian"
                    android:textColorHint="@color/obsidian_muted"
                    android:paddingHorizontal="12dp"
                    android:inputType="number|numberSigned"
                    android:layout_marginBottom="16dp"/>

                <FrameLayout
                    android:id="@+id/btn_save_tg"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_fab"
                    android:clickable="true"
                    android:focusable="true">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="Save &amp; Test Connection"
                        android:textSize="13sp"
                        android:textColor="@color/bg_primary"
                        android:fontFamily="sans-serif-medium"/>
                </FrameLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Sync status -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="4dp"
            android:layout_marginBottom="20dp">

            <View
                android:id="@+id/sync_dot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/bg_dot"
                android:backgroundTint="#888888"
                android:layout_marginEnd="8dp"/>

            <TextView
                android:id="@+id/tv_sync_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Not connected"
                android:textSize="12sp"
                android:textColor="@color/obsidian_muted"/>
        </LinearLayout>

        <!-- ══ SYNC ══════════════════════════════════════════════════ -->
        <TextView style="@style/SectionLabel" android:text="SYNC" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/bg_card"
            android:layout_marginBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Sync now button -->
                <LinearLayout
                    android:id="@+id/row_sync_now"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="16dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?android:attr/selectableItemBackground">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Sync Now"
                        android:textSize="14sp"
                        android:textColor="@color/obsidian"/>

                    <ImageView
                        android:id="@+id/ic_sync_now"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_sync"
                        android:alpha="0.5"
                        android:contentDescription="Sync"/>
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="0.5dp"
                    android:background="@color/divider" android:layout_marginHorizontal="16dp"/>

                <!-- Last sync time -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="16dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Last Synced"
                        android:textSize="14sp"
                        android:textColor="@color/obsidian"/>

                    <TextView
                        android:id="@+id/tv_last_sync"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Never"
                        android:textSize="13sp"
                        android:textColor="@color/obsidian_muted"/>
                </LinearLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ══ ABOUT ══════════════════════════════════════════════════ -->
        <TextView style="@style/SectionLabel" android:text="ABOUT" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/bg_card"
            android:layout_marginBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="16dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Version"
                        android:textSize="14sp"
                        android:textColor="@color/obsidian"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1.0.0"
                        android:textSize="13sp"
                        android:textColor="@color/obsidian_muted"/>
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="0.5dp"
                    android:background="@color/divider" android:layout_marginHorizontal="16dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="16dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Package"
                        android:textSize="14sp"
                        android:textColor="@color/obsidian"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="com.prompta.tg"
                        android:textSize="12sp"
                        android:fontFamily="monospace"
                        android:textColor="@color/obsidian_muted"/>
                </LinearLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>
