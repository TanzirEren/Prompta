<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Format toolbar button (text) -->
    <style name="FormatBtn">
        <item name="android:layout_width">36dp</item>
        <item name="android:layout_height">36dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/obsidian</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:background">?android:attr/selectableItemBackgroundBorderless</item>
        <item name="android:layout_marginHorizontal">1dp</item>
    </style>

    <!-- Format toolbar button (icon) -->
    <style name="FormatBtnImg">
        <item name="android:layout_width">36dp</item>
        <item name="android:layout_height">36dp</item>
        <item name="android:padding">8dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:background">?android:attr/selectableItemBackgroundBorderless</item>
        <item name="android:layout_marginHorizontal">1dp</item>
        <item name="android:scaleType">centerInside</item>
    </style>

    <!-- Toolbar divider -->
    <style name="ToolbarDivider">
        <item name="android:layout_width">0.5dp</item>
        <item name="android:layout_height">20dp</item>
        <item name="android:background">@color/divider</item>
        <item name="android:layout_marginHorizontal">4dp</item>
    </style>

    <!-- Selection toolbar button -->
    <style name="SelectionBtn">
        <item name="android:layout_width">38dp</item>
        <item name="android:layout_height">38dp</item>
        <item name="android:padding">8dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:background">?android:attr/selectableItemBackgroundBorderless</item>
        <item name="android:scaleType">centerInside</item>
    </style>


    <!-- Settings section label -->
    <style name="SectionLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/obsidian_muted</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.1</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:layout_marginStart">4dp</item>
    </style>

</resources>
