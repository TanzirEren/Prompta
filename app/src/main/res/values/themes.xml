<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Prompta" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/obsidian</item>
        <item name="colorPrimaryVariant">@color/obsidian_light</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSurface">@color/bg_primary</item>
        <item name="android:colorBackground">@color/bg_primary</item>
        <item name="android:windowBackground">@color/bg_primary</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
    </style>

    <!-- Splash Screen theme — activity starts with this, then switches to Theme.Prompta -->
    <style name="Theme.Prompta.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/bg_primary</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.Prompta</item>
    </style>
</resources>
